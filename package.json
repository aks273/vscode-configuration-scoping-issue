{
	"name": "configuration-scoping-issue",
	"displayName": "Configuration Scoping Issue",
	"description": "Demo extension illustrating scoping issues with machine-scoped VS Code configuration",
	"version": "0.0.1",
	"publisher": "configuration-scoping-issue",
	"repository": "https://github.com/aks273/vscode-configuration-scoping-issue",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": ["onStartupFinished"],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "Configuration Scoping Issue",
			"properties": {
				"configScopingIssue.machineString": {
					"type": "string",
					"default": "Hello, world!",
					"scope": "machine",
					"description": "A machine-scoped string setting."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"package": "vsce package"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.0.0",
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	}
}
